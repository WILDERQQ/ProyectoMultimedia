<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="umsa_tramites" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.16.0">
  <collaboration id="Collab_TituloProfesional">
    <participant id="Pool_Titulo" name="Trámite: Título Profesional (Ex Provisión Nacional)" processRef="Proc_Titulo" />
  </collaboration>
  <process id="Proc_Titulo" isExecutable="false">
    <laneSet id="LaneSet_Titulo">
      <lane id="Lane_Decanato" name="Decanato / Secretaría de Títulos (Aprobador)">
        <flowNodeRef>Task_D4_RechazarSolicitud</flowNodeRef>
        <flowNodeRef>End_Titulo_Aprobado</flowNodeRef>
        <flowNodeRef>Task_D5_EmitirTitulo</flowNodeRef>
        <flowNodeRef>Task_D3_AprobarSolicitud</flowNodeRef>
        <flowNodeRef>Task_D1_RecibirSolicitud</flowNodeRef>
        <flowNodeRef>Task_D2_VerificarRequisitos</flowNodeRef>
        <flowNodeRef>End_Titulo_Rechazado</flowNodeRef>
        <flowNodeRef>GW_D_Requisitos_OK</flowNodeRef>
      </lane>
      <lane id="Lane_Banco" name="Entidad Bancaria / Pasarela de Pago">
        <flowNodeRef>Task_B1_ProcesarPago</flowNodeRef>
        <flowNodeRef>Task_B2_ConfirmarPago</flowNodeRef>
      </lane>
      <lane id="Lane_SistemaUMSA" name="Sistema UMSA (tramitesenlinea.umsa.bo)">
        <flowNodeRef>Task_S1_ValidarCredenciales</flowNodeRef>
        <flowNodeRef>Task_S2_MostrarFormulario</flowNodeRef>
        <flowNodeRef>Task_S3_RecuperarDatos</flowNodeRef>
        <flowNodeRef>Task_S6_GenerarDocFD</flowNodeRef>
        <flowNodeRef>Task_S4_GenerarSolicitud</flowNodeRef>
        <flowNodeRef>Task_S5_ProcessPayment</flowNodeRef>
      </lane>
      <lane id="Lane_Estudiante" name="Estudiante (Solicitante / Remitente)">
        <flowNodeRef>Start_Titulo</flowNodeRef>
        <flowNodeRef>Task_T1_Acceso</flowNodeRef>
        <flowNodeRef>Task_T2_Login</flowNodeRef>
        <flowNodeRef>Task_T3_NavMenu</flowNodeRef>
        <flowNodeRef>Task_T4_NuevaSolicitud</flowNodeRef>
        <flowNodeRef>Task_T5_BuscarDatos</flowNodeRef>
        <flowNodeRef>Task_T6_DatosPersonales</flowNodeRef>
        <flowNodeRef>Task_T7_DatosAcademicos</flowNodeRef>
        <flowNodeRef>GW_T_Datos_OK</flowNodeRef>
        <flowNodeRef>End_Titulo_Estudiante</flowNodeRef>
        <flowNodeRef>Task_T12_AdjuntarRequisitos</flowNodeRef>
        <flowNodeRef>Task_T11_ImprimirDocs</flowNodeRef>
        <flowNodeRef>Task_T9_Confirmacion</flowNodeRef>
        <flowNodeRef>Task_T8_DatosBachiller</flowNodeRef>
        <flowNodeRef>GW_T_Pago_OK</flowNodeRef>
        <flowNodeRef>Task_T10_MetodoPago</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Titulo" name="Inicio: Solicitud Título Profesional">
      <outgoing>SF_T01</outgoing>
    </startEvent>
    <task id="Task_T1_Acceso" name="1. Acceder a tramitesenlinea.umsa.bo">
      <incoming>SF_T01</incoming>
      <outgoing>SF_T02</outgoing>
    </task>
    <task id="Task_T2_Login" name="2. Ingresar Usuario y Contraseña → Iniciar Sesión">
      <incoming>SF_T02</incoming>
      <outgoing>SF_T03</outgoing>
    </task>
    <task id="Task_T3_NavMenu" name="3. Navegar a TÍTULOS Y DIPLOMAS → Título Profesional">
      <incoming>SF_T04</incoming>
      <outgoing>SF_T05</outgoing>
    </task>
    <task id="Task_T4_NuevaSolicitud" name="4. Hacer clic en + NUEVA SOLICITUD">
      <incoming>SF_T05</incoming>
      <outgoing>SF_T06</outgoing>
    </task>
    <task id="Task_T5_BuscarDatos" name="5. Ingresar Tipo Doc, CI/Pasaporte y RU → Buscar">
      <incoming>SF_T07</incoming>
      <outgoing>SF_T08</outgoing>
    </task>
    <task id="Task_T6_DatosPersonales" name="6. Completar Datos Personales (Lugar Nacimiento, Celular, Correo)">
      <incoming>SF_T08</incoming>
      <outgoing>SF_T09</outgoing>
    </task>
    <task id="Task_T7_DatosAcademicos" name="7. Seleccionar Nivel y Grado Académico">
      <incoming>SF_T09</incoming>
      <outgoing>SF_T10</outgoing>
    </task>
    <task id="Task_S1_ValidarCredenciales" name="Validar credenciales del usuario">
      <incoming>SF_T03</incoming>
      <outgoing>SF_T04</outgoing>
    </task>
    <task id="Task_S2_MostrarFormulario" name="Mostrar formulario Búsqueda Datos Solicitantes">
      <incoming>SF_T06</incoming>
      <outgoing>SF_T07</outgoing>
    </task>
    <task id="Task_S3_RecuperarDatos" name="Recuperar datos académicos del estudiante">
      <incoming>SF_T08_SYS</incoming>
      <outgoing>SF_T08</outgoing>
    </task>
    <task id="Task_S6_GenerarDocFD" name="Generar Formulario F.D. y Comprobante de pago">
      <incoming>SF_T17_SYS</incoming>
      <outgoing>SF_T17</outgoing>
    </task>
    <task id="Task_B1_ProcesarPago" name="Procesar pago (QR Banco Unión / CPT / Otros)">
      <incoming>SF_T16</incoming>
      <outgoing>SF_B01</outgoing>
    </task>
    <task id="Task_B2_ConfirmarPago" name="Confirmar transacción exitosa">
      <incoming>SF_B01</incoming>
      <outgoing>SF_T17_SYS</outgoing>
    </task>
    <exclusiveGateway id="GW_T_Datos_OK" name="¿Datos correctos?">
      <incoming>SF_T11</incoming>
      <outgoing>SF_T12_SI</outgoing>
      <outgoing>SF_T12_NO</outgoing>
    </exclusiveGateway>
    <endEvent id="End_Titulo_Estudiante" name="Requisitos entregados al Decanato">
      <incoming>SF_T20</incoming>
    </endEvent>
    <task id="Task_T12_AdjuntarRequisitos" name="12. Adjuntar documentos físicos al trámite">
      <incoming>SF_T19</incoming>
      <outgoing>SF_T20</outgoing>
    </task>
    <task id="Task_T11_ImprimirDocs" name="11. Imprimir Formulario F.D. y Ver Comprobante">
      <incoming>SF_T18_SI</incoming>
      <outgoing>SF_T19</outgoing>
    </task>
    <task id="Task_S4_GenerarSolicitud" name="Generar solicitud con número de trámite">
      <incoming>SF_T13</incoming>
      <outgoing>SF_T14</outgoing>
    </task>
    <task id="Task_T9_Confirmacion" name="9. Confirmar datos (ventana de confirmación → Sí)">
      <incoming>SF_T12_SI</incoming>
      <outgoing>SF_T13</outgoing>
    </task>
    <task id="Task_T8_DatosBachiller" name="8. Seleccionar Área de Bachiller → Siguiente">
      <incoming>SF_T10</incoming>
      <outgoing>SF_T11</outgoing>
    </task>
    <exclusiveGateway id="GW_T_Pago_OK" name="¿Pago confirmado?">
      <incoming>SF_T17</incoming>
      <outgoing>SF_T18_SI</outgoing>
      <outgoing>SF_T18_NO</outgoing>
    </exclusiveGateway>
    <task id="Task_T10_MetodoPago" name="10. Seleccionar Método de Pago → Enviar Solicitud">
      <incoming>SF_T14</incoming>
      <outgoing>SF_T15</outgoing>
    </task>
    <task id="Task_S5_ProcessPayment" name="Procesar orden de pago / CPT">
      <incoming>SF_T15</incoming>
      <outgoing>SF_T16</outgoing>
    </task>
    <task id="Task_D4_RechazarSolicitud" name="Notificar rechazo al estudiante con observaciones">
      <incoming>SF_D03_NO</incoming>
      <outgoing>SF_D05</outgoing>
    </task>
    <endEvent id="End_Titulo_Aprobado" name="Título Profesional emitido y entregado">
      <incoming>SF_D06</incoming>
    </endEvent>
    <task id="Task_D5_EmitirTitulo" name="Emitir y registrar Título Profesional (Emisor)">
      <incoming>SF_D04</incoming>
      <outgoing>SF_D06</outgoing>
    </task>
    <task id="Task_D3_AprobarSolicitud" name="Aprobar solicitud de Título Profesional">
      <incoming>SF_D03_SI</incoming>
      <outgoing>SF_D04</outgoing>
    </task>
    <task id="Task_D1_RecibirSolicitud" name="Recibir expediente físico con requisitos">
      <incoming>SF_T20_DEC</incoming>
      <outgoing>SF_D01</outgoing>
    </task>
    <task id="Task_D2_VerificarRequisitos" name="Verificar documentación y requisitos">
      <incoming>SF_D01</incoming>
      <outgoing>SF_D02</outgoing>
    </task>
    <endEvent id="End_Titulo_Rechazado" name="Solicitud rechazada - Subsanar observaciones">
      <incoming>SF_D05</incoming>
    </endEvent>
    <exclusiveGateway id="GW_D_Requisitos_OK" name="¿Documentación completa y válida?">
      <incoming>SF_D02</incoming>
      <outgoing>SF_D03_SI</outgoing>
      <outgoing>SF_D03_NO</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SF_T01" sourceRef="Start_Titulo" targetRef="Task_T1_Acceso" />
    <sequenceFlow id="SF_T02" sourceRef="Task_T1_Acceso" targetRef="Task_T2_Login" />
    <sequenceFlow id="SF_T03" sourceRef="Task_T2_Login" targetRef="Task_S1_ValidarCredenciales" />
    <sequenceFlow id="SF_T04" sourceRef="Task_S1_ValidarCredenciales" targetRef="Task_T3_NavMenu" />
    <sequenceFlow id="SF_T05" sourceRef="Task_T3_NavMenu" targetRef="Task_T4_NuevaSolicitud" />
    <sequenceFlow id="SF_T06" sourceRef="Task_T4_NuevaSolicitud" targetRef="Task_S2_MostrarFormulario" />
    <sequenceFlow id="SF_T07" sourceRef="Task_S2_MostrarFormulario" targetRef="Task_T5_BuscarDatos" />
    <sequenceFlow id="SF_T08_SYS" sourceRef="Task_T5_BuscarDatos" targetRef="Task_S3_RecuperarDatos" />
    <sequenceFlow id="SF_T08" sourceRef="Task_S3_RecuperarDatos" targetRef="Task_T6_DatosPersonales" />
    <sequenceFlow id="SF_T12_NO" name="No, revisar" sourceRef="GW_T_Datos_OK" targetRef="Task_T6_DatosPersonales" />
    <sequenceFlow id="SF_T09" sourceRef="Task_T6_DatosPersonales" targetRef="Task_T7_DatosAcademicos" />
    <sequenceFlow id="SF_T10" sourceRef="Task_T7_DatosAcademicos" targetRef="Task_T8_DatosBachiller" />
    <sequenceFlow id="SF_T17_SYS" sourceRef="Task_B2_ConfirmarPago" targetRef="Task_S6_GenerarDocFD" />
    <sequenceFlow id="SF_T17" sourceRef="Task_S6_GenerarDocFD" targetRef="GW_T_Pago_OK" />
    <sequenceFlow id="SF_T16" sourceRef="Task_S5_ProcessPayment" targetRef="Task_B1_ProcesarPago" />
    <sequenceFlow id="SF_B01" sourceRef="Task_B1_ProcesarPago" targetRef="Task_B2_ConfirmarPago" />
    <sequenceFlow id="SF_T11" sourceRef="Task_T8_DatosBachiller" targetRef="GW_T_Datos_OK" />
    <sequenceFlow id="SF_T12_SI" name="Sí, datos correctos" sourceRef="GW_T_Datos_OK" targetRef="Task_T9_Confirmacion" />
    <sequenceFlow id="SF_T20" sourceRef="Task_T12_AdjuntarRequisitos" targetRef="End_Titulo_Estudiante" />
    <sequenceFlow id="SF_T19" sourceRef="Task_T11_ImprimirDocs" targetRef="Task_T12_AdjuntarRequisitos" />
    <sequenceFlow id="SF_T20_DEC" sourceRef="Task_T12_AdjuntarRequisitos" targetRef="Task_D1_RecibirSolicitud" />
    <sequenceFlow id="SF_T18_SI" name="Pago confirmado" sourceRef="GW_T_Pago_OK" targetRef="Task_T11_ImprimirDocs" />
    <sequenceFlow id="SF_T13" sourceRef="Task_T9_Confirmacion" targetRef="Task_S4_GenerarSolicitud" />
    <sequenceFlow id="SF_T14" sourceRef="Task_S4_GenerarSolicitud" targetRef="Task_T10_MetodoPago" />
    <sequenceFlow id="SF_T18_NO" name="Pago fallido" sourceRef="GW_T_Pago_OK" targetRef="Task_T10_MetodoPago" />
    <sequenceFlow id="SF_T15" sourceRef="Task_T10_MetodoPago" targetRef="Task_S5_ProcessPayment" />
    <sequenceFlow id="SF_D03_NO" name="Documentación incompleta" sourceRef="GW_D_Requisitos_OK" targetRef="Task_D4_RechazarSolicitud" />
    <sequenceFlow id="SF_D05" sourceRef="Task_D4_RechazarSolicitud" targetRef="End_Titulo_Rechazado" />
    <sequenceFlow id="SF_D06" sourceRef="Task_D5_EmitirTitulo" targetRef="End_Titulo_Aprobado" />
    <sequenceFlow id="SF_D04" sourceRef="Task_D3_AprobarSolicitud" targetRef="Task_D5_EmitirTitulo" />
    <sequenceFlow id="SF_D03_SI" name="Documentación completa" sourceRef="GW_D_Requisitos_OK" targetRef="Task_D3_AprobarSolicitud" />
    <sequenceFlow id="SF_D01" sourceRef="Task_D1_RecibirSolicitud" targetRef="Task_D2_VerificarRequisitos" />
    <sequenceFlow id="SF_D02" sourceRef="Task_D2_VerificarRequisitos" targetRef="GW_D_Requisitos_OK" />
  </process>
  <collaboration id="Collab_CertNoProc">
    <participant id="Pool_Cert" name="Trámite: Certificado de No Tener Proceso Universitario" processRef="Proc_Cert" />
  </collaboration>
  <process id="Proc_Cert" isExecutable="false">
    <laneSet id="LaneSet_Cert">
      <lane id="Lane_C_Solicitante" name="Solicitante (Docente / Administrativo / Universitario - Remitente)">
        <flowNodeRef>Start_Cert</flowNodeRef>
        <flowNodeRef>Task_C1_PrepararDocs</flowNodeRef>
        <flowNodeRef>Task_C2_AccesoWeb</flowNodeRef>
        <flowNodeRef>Task_C3_NavCertificaciones</flowNodeRef>
        <flowNodeRef>Task_C4_NuevaSolicitudCert</flowNodeRef>
        <flowNodeRef>Task_C5_DatosPersonalesCert</flowNodeRef>
        <flowNodeRef>Task_C6_AdjuntarCarnet</flowNodeRef>
        <flowNodeRef>Task_C7_DatosCertificado</flowNodeRef>
        <flowNodeRef>Task_C8_Finalizar</flowNodeRef>
        <flowNodeRef>Task_C9_ObtenerCPT</flowNodeRef>
        <flowNodeRef>Task_C10_DescargarOrden</flowNodeRef>
        <flowNodeRef>Task_C12_ImprimirCertificado</flowNodeRef>
        <flowNodeRef>End_Cert_Solicitante</flowNodeRef>
        <flowNodeRef>GW_C_Datos_OK</flowNodeRef>
      </lane>
      <lane id="Lane_C_Sistema" name="Sistema UMSA (tramitesenlinea.umsa.bo)">
        <flowNodeRef>Task_CS1_RegistrarSolicitud</flowNodeRef>
        <flowNodeRef>Task_CS2_GenerarCPT</flowNodeRef>
        <flowNodeRef>Task_CS3_ActualizarEstado</flowNodeRef>
        <flowNodeRef>Task_CS4_GenerarCertificado</flowNodeRef>
      </lane>
      <lane id="Lane_C_Banco" name="Entidad Bancaria Autorizada">
        <flowNodeRef>Task_CB1_RealizarPago</flowNodeRef>
        <flowNodeRef>Task_CB2_ConfirmarPagoCert</flowNodeRef>
      </lane>
      <lane id="Lane_C_Comision" name="Comisión Universitaria de Procesos (Aprobador / Emisor)">
        <flowNodeRef>Task_CP1_RecibirSolicitud</flowNodeRef>
        <flowNodeRef>Task_CP2_RevisionExpediente</flowNodeRef>
        <flowNodeRef>GW_CP_Proceso_Existe</flowNodeRef>
        <flowNodeRef>Task_CP3_EmitirCertificado</flowNodeRef>
        <flowNodeRef>Task_CP4_DenegarCertificado</flowNodeRef>
        <flowNodeRef>Task_CP5_NotificarSolicitante</flowNodeRef>
        <flowNodeRef>End_Cert_Aprobado</flowNodeRef>
        <flowNodeRef>End_Cert_Denegado</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Cert" name="Inicio: Solicitud Certificado No Procesos">
      <outgoing>SFC_01</outgoing>
    </startEvent>
    <task id="Task_C1_PrepararDocs" name="0. Preparar documentos previos (CI digital + matrícula si es universitario)">
      <incoming>SFC_01</incoming>
      <outgoing>SFC_02</outgoing>
    </task>
    <task id="Task_C2_AccesoWeb" name="1. Acceder a tramitesenlinea.umsa.bo">
      <incoming>SFC_02</incoming>
      <outgoing>SFC_03</outgoing>
    </task>
    <task id="Task_C3_NavCertificaciones" name="2. Navegar a CERTIFICACIONES → Certificado No Procesos Universitarios">
      <incoming>SFC_03</incoming>
      <outgoing>SFC_04</outgoing>
    </task>
    <task id="Task_C4_NuevaSolicitudCert" name="3. Hacer clic en + NUEVA SOLICITUD">
      <incoming>SFC_04</incoming>
      <outgoing>SFC_05</outgoing>
    </task>
    <task id="Task_C5_DatosPersonalesCert" name="4. Completar Datos Personales (Estamento, Correo, Celular)">
      <incoming>SFC_05</incoming>
      <outgoing>SFC_06</outgoing>
    </task>
    <task id="Task_C6_AdjuntarCarnet" name="5. Adjuntar copia digital del CI (PDF o imagen) → Siguiente">
      <incoming>SFC_06</incoming>
      <outgoing>SFC_07</outgoing>
    </task>
    <task id="Task_C7_DatosCertificado" name="6. Completar Datos del Certificado (Objeto, Unidad a postular, Convocatoria)">
      <incoming>SFC_07</incoming>
      <outgoing>SFC_08</outgoing>
    </task>
    <exclusiveGateway id="GW_C_Datos_OK" name="¿Datos del certificado correctos?">
      <incoming>SFC_08</incoming>
      <outgoing>SFC_09_SI</outgoing>
      <outgoing>SFC_09_NO</outgoing>
    </exclusiveGateway>
    <task id="Task_C8_Finalizar" name="7. Hacer clic en Finalizar → Confirmar con Sí">
      <incoming>SFC_09_SI</incoming>
      <outgoing>SFC_10</outgoing>
    </task>
    <task id="Task_C9_ObtenerCPT" name="9. Ver monto a cancelar y Código CPT generado">
      <incoming>SFC_12</incoming>
      <outgoing>SFC_13</outgoing>
    </task>
    <task id="Task_C10_DescargarOrden" name="10. Descargar Orden de Pago (PDF con datos CPT)">
      <incoming>SFC_13</incoming>
      <outgoing>SFC_14</outgoing>
    </task>
    <task id="Task_C12_ImprimirCertificado" name="12. Imprimir Certificado (botón verde Imprimir)">
      <incoming>SFC_18</incoming>
      <outgoing>SFC_19</outgoing>
    </task>
    <endEvent id="End_Cert_Solicitante" name="Certificado descargado e impreso">
      <incoming>SFC_19</incoming>
    </endEvent>
    <task id="Task_CS1_RegistrarSolicitud" name="8. Registrar solicitud → Enviar aviso a Comisión Universitaria">
      <incoming>SFC_10</incoming>
      <outgoing>SFC_11</outgoing>
    </task>
    <task id="Task_CS2_GenerarCPT" name="Generar Código CPT y monto de pago">
      <incoming>SFC_11</incoming>
      <outgoing>SFC_12</outgoing>
    </task>
    <task id="Task_CS3_ActualizarEstado" name="Actualizar estado a Trámite Concluido">
      <incoming>SFC_17</incoming>
      <outgoing>SFC_18</outgoing>
    </task>
    <task id="Task_CS4_GenerarCertificado" name="Generar PDF del Certificado listo para descarga">
      <incoming>SFC_CP04</incoming>
      <outgoing>SFC_17</outgoing>
    </task>
    <task id="Task_CB1_RealizarPago" name="11. Realizar pago CPT en entidad autorizada">
      <incoming>SFC_14</incoming>
      <outgoing>SFC_15</outgoing>
    </task>
    <task id="Task_CB2_ConfirmarPagoCert" name="Confirmar pago y notificar al sistema">
      <incoming>SFC_15</incoming>
      <outgoing>SFC_16</outgoing>
    </task>
    <task id="Task_CP1_RecibirSolicitud" name="Recibir solicitud del sistema (plazo: 48 horas hábiles)">
      <incoming>SFC_11_COM</incoming>
      <outgoing>SFC_CP01</outgoing>
    </task>
    <task id="Task_CP2_RevisionExpediente" name="Revisar antecedentes del solicitante en registros universitarios">
      <incoming>SFC_16</incoming>
      <outgoing>SFC_CP02</outgoing>
    </task>
    <exclusiveGateway id="GW_CP_Proceso_Existe" name="¿Existe proceso universitario vigente?">
      <incoming>SFC_CP02</incoming>
      <outgoing>SFC_CP03_NO</outgoing>
      <outgoing>SFC_CP03_SI</outgoing>
    </exclusiveGateway>
    <task id="Task_CP3_EmitirCertificado" name="Aprobar y emitir Certificado de No Proceso (Emisor)">
      <incoming>SFC_CP03_NO</incoming>
      <outgoing>SFC_CP04</outgoing>
    </task>
    <task id="Task_CP4_DenegarCertificado" name="Denegar solicitud: existe proceso activo">
      <incoming>SFC_CP03_SI</incoming>
      <outgoing>SFC_CP05</outgoing>
    </task>
    <task id="Task_CP5_NotificarSolicitante" name="Notificar al solicitante vía correo electrónico">
      <incoming>SFC_CP05</incoming>
      <outgoing>SFC_CP06</outgoing>
    </task>
    <endEvent id="End_Cert_Aprobado" name="Certificado emitido y disponible para descarga">
      <incoming>SFC_CP04_END</incoming>
    </endEvent>
    <endEvent id="End_Cert_Denegado" name="Solicitud denegada - Proceso universitario activo">
      <incoming>SFC_CP06</incoming>
    </endEvent>
    <sequenceFlow id="SFC_01" sourceRef="Start_Cert" targetRef="Task_C1_PrepararDocs" />
    <sequenceFlow id="SFC_02" sourceRef="Task_C1_PrepararDocs" targetRef="Task_C2_AccesoWeb" />
    <sequenceFlow id="SFC_03" sourceRef="Task_C2_AccesoWeb" targetRef="Task_C3_NavCertificaciones" />
    <sequenceFlow id="SFC_04" sourceRef="Task_C3_NavCertificaciones" targetRef="Task_C4_NuevaSolicitudCert" />
    <sequenceFlow id="SFC_05" sourceRef="Task_C4_NuevaSolicitudCert" targetRef="Task_C5_DatosPersonalesCert" />
    <sequenceFlow id="SFC_06" sourceRef="Task_C5_DatosPersonalesCert" targetRef="Task_C6_AdjuntarCarnet" />
    <sequenceFlow id="SFC_07" sourceRef="Task_C6_AdjuntarCarnet" targetRef="Task_C7_DatosCertificado" />
    <sequenceFlow id="SFC_08" sourceRef="Task_C7_DatosCertificado" targetRef="GW_C_Datos_OK" />
    <sequenceFlow id="SFC_09_SI" name="Sí, confirmar" sourceRef="GW_C_Datos_OK" targetRef="Task_C8_Finalizar" />
