    <sequenceFlow id="SF_06" sourceRef="Task_C4_DatosPersonales" targetRef="Task_C5_AdjuntarCarnet" />
    <sequenceFlow id="SF_GW_P_SI" name="Proceso vigente" sourceRef="GW_ProcesoVigente" targetRef="Task_P4_DenegarSolicitud" />
    <sequenceFlow id="SF_P2" sourceRef="Task_P2_RevisarAntecedentes" targetRef="GW_ProcesoVigente" />
    <sequenceFlow id="SF_GW_P_NO" name="No hay proceso" sourceRef="GW_ProcesoVigente" targetRef="Task_P3_AprobarEmitir" />
    <sequenceFlow id="SF_P1" sourceRef="Task_P1_RecibirSolicitud" targetRef="Task_P2_RevisarAntecedentes" />
    <sequenceFlow id="SF_B1" sourceRef="Task_B1_RealizarPago" targetRef="Gateway_1l4rubo" />
    <sequenceFlow id="Flow_0hh692g" name="Enviar Aviso" sourceRef="Gateway_1l4rubo" targetRef="Task_P1_RecibirSolicitud" />
    <sequenceFlow id="Flow_1m0r5qt" sourceRef="Gateway_1l4rubo" targetRef="Activity_0moowy2" />
    <sequenceFlow id="Flow_0pnvv6y" sourceRef="Activity_0moowy2" targetRef="Event_07m5kvt" />
  </process>
