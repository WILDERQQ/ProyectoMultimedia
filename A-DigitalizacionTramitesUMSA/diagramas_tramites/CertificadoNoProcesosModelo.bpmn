  <collaboration id="Collab_CertNoProc">
    <participant id="Pool_Cert" name="Trámite: Certificado de No Tener Proceso Universitario — UMSA" processRef="Proc_Cert" />
  </collaboration>
  <process id="Proc_Cert" isExecutable="false">
    <laneSet id="LaneSet_Cert">
      <lane id="Lane_Comision" name="Comisión Universitaria de Procesos (Aprobador / Emisor)">
        <flowNodeRef>End_Aprobado</flowNodeRef>
        <flowNodeRef>Task_P5_NotificarRechazo</flowNodeRef>
        <flowNodeRef>Task_P4_DenegarSolicitud</flowNodeRef>
        <flowNodeRef>End_Denegado</flowNodeRef>
        <flowNodeRef>GW_ProcesoVigente</flowNodeRef>
        <flowNodeRef>Task_P3_AprobarEmitir</flowNodeRef>
        <flowNodeRef>Task_P2_RevisarAntecedentes</flowNodeRef>
        <flowNodeRef>Task_P1_RecibirSolicitud</flowNodeRef>
      </lane>
      <lane id="Lane_Banco" name="Entidad Bancaria Autorizada (Procesador de Pago)">
        <flowNodeRef>Task_B1_RealizarPago</flowNodeRef>
        <flowNodeRef>Gateway_1l4rubo</flowNodeRef>
        <flowNodeRef>Activity_0moowy2</flowNodeRef>
        <flowNodeRef>Event_07m5kvt</flowNodeRef>
      </lane>
      <lane id="Lane_Sistema" name="Sistema UMSA (tramitesenlinea.umsa.bo)">
        <flowNodeRef>Task_S1_RegistrarSolicitud</flowNodeRef>
        <flowNodeRef>Task_S2_GenerarCPT</flowNodeRef>
        <flowNodeRef>Task_S3_ActualizarEstado</flowNodeRef>
        <flowNodeRef>Task_S4_GenerarCertificadoPDF</flowNodeRef>
      </lane>
      <lane id="Lane_Solicitante" name="Solicitante (Docente / Administrativo / Universitario — Remitente)">
        <flowNodeRef>Task_C8_ObtenerCPT</flowNodeRef>
        <flowNodeRef>Task_C7_Finalizar</flowNodeRef>
        <flowNodeRef>GW_DatosOK</flowNodeRef>
        <flowNodeRef>Task_C6_DatosCert</flowNodeRef>
        <flowNodeRef>Task_C10_ImprimirCert</flowNodeRef>
        <flowNodeRef>End_Solicitante</flowNodeRef>
        <flowNodeRef>Task_C9_DescargarOrden</flowNodeRef>
        <flowNodeRef>Start_Cert</flowNodeRef>
        <flowNodeRef>Task_C0_PrepararDocs</flowNodeRef>
        <flowNodeRef>Task_C1_AccesoWeb</flowNodeRef>
        <flowNodeRef>Task_C2_NavCert</flowNodeRef>
        <flowNodeRef>Task_C3_NuevaSolicitud</flowNodeRef>
        <flowNodeRef>Task_C4_DatosPersonales</flowNodeRef>
        <flowNodeRef>Task_C5_AdjuntarCarnet</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_S1_RegistrarSolicitud" name="8. Registrar solicitud y &#10;&#39;¡Solicitud registrada!&#39; — plazo 48 h hábiles">
      <incoming>SF_09</incoming>
      <outgoing>SF_S1_CPT</outgoing>
    </task>
    <task id="Task_S2_GenerarCPT" name="Generar Código de Pago de Trámite (CPT)&#10;y notificar al solicitante">
      <incoming>SF_S1_CPT</incoming>
      <outgoing>SF_S2_SOL</outgoing>
    </task>
    <task id="Task_C8_ObtenerCPT" name="9. Ver monto y código CPT generado&#10;en pantalla de detalles del trámite">
      <incoming>SF_S2_SOL</incoming>
      <outgoing>SF_10</outgoing>
    </task>
    <task id="Task_S3_ActualizarEstado" name="Actualizar estado a &#39;Trámite Concluido&#39;&#10;y habilitar descarga del certificado">
      <incoming>SF_P3_SYS</incoming>
      <outgoing>SF_S3_CERT</outgoing>
    </task>
    <task id="Task_S4_GenerarCertificadoPDF" name="Generar PDF del Certificado de No Proceso">
      <incoming>SF_S3_CERT</incoming>
      <outgoing>SF_S3_SOL</outgoing>
    </task>
    <task id="Task_C7_Finalizar" name="7. Hacer clic en Finalizar → Confirmar (Sí)&#10;[Solicitud registrada — enviada a Comisión]">
      <incoming>SF_GW_SI</incoming>
      <outgoing>SF_09</outgoing>
    </task>
    <exclusiveGateway id="GW_DatosOK" name="¿Datos del certificado correctos?">
      <incoming>SF_08</incoming>
      <outgoing>SF_GW_SI</outgoing>
      <outgoing>SF_GW_NO</outgoing>
    </exclusiveGateway>
    <task id="Task_C6_DatosCert" name="6. Completar Datos del Certificado&#10;(Objeto, Unidad a postular, Convocatoria)">
      <incoming>SF_07</incoming>
      <incoming>SF_GW_NO</incoming>
      <outgoing>SF_08</outgoing>
    </task>
    <task id="Task_C10_ImprimirCert" name="12. Imprimir / descargar Certificado&#10;(botón verde Imprimir — estado: Trámite Concluido)">
      <incoming>SF_S3_SOL</incoming>
      <outgoing>SF_FIN</outgoing>
    </task>
    <endEvent id="End_Solicitante" name="Certificado obtenido por el Solicitante">
      <incoming>SF_FIN</incoming>
    </endEvent>
    <task id="Task_C9_DescargarOrden" name="10. Descargar Orden de Pago (PDF con CPT)">
      <incoming>SF_10</incoming>
      <outgoing>SF_11</outgoing>
    </task>
    <endEvent id="End_Aprobado" name="Certificado emitido y disponible para descarga">
      <incoming>SF_P3_END</incoming>
    </endEvent>
    <task id="Task_P5_NotificarRechazo" name="Notificar al solicitante vía correo electrónico&#10;indicando el motivo del rechazo">
      <incoming>SF_P4</incoming>
      <outgoing>SF_P5</outgoing>
    </task>
    <startEvent id="Start_Cert" name="Inicio: Solicitud Certificado No Procesos Universitarios">
      <outgoing>SF_01</outgoing>
    </startEvent>
    <task id="Task_C0_PrepararDocs" name="0. Preparar Documentos">
      <incoming>SF_01</incoming>
      <outgoing>SF_02</outgoing>
    </task>
    <task id="Task_C1_AccesoWeb" name="1. Acceder a tramitesenlinea.umsa.bo">
      <incoming>SF_02</incoming>
      <outgoing>SF_03</outgoing>
    </task>
    <task id="Task_C2_NavCert" name="2. Navegar a CERTIFICACIONES → Certificado No Procesos Universitarios">
      <incoming>SF_03</incoming>
      <outgoing>SF_04</outgoing>
    </task>
    <task id="Task_C3_NuevaSolicitud" name="3. Hacer clic en + NUEVA SOLICITUD">
      <incoming>SF_04</incoming>
      <outgoing>SF_05</outgoing>
    </task>
    <task id="Task_C4_DatosPersonales" name="4. Completar Datos Personales&#10;(Estamento, Correo electrónico, Celular)">
      <incoming>SF_05</incoming>
      <outgoing>SF_06</outgoing>
    </task>
    <task id="Task_C5_AdjuntarCarnet" name="5. Adjuntar copia digital del CI (PDF o imagen) → Siguiente">
      <incoming>SF_06</incoming>
      <outgoing>SF_07</outgoing>
    </task>
    <task id="Task_P4_DenegarSolicitud" name="Denegar solicitud: existe proceso universitario activo">
      <incoming>SF_GW_P_SI</incoming>
      <outgoing>SF_P4</outgoing>
    </task>
    <endEvent id="End_Denegado" name="Solicitud denegada — Proceso universitario activo">
      <incoming>SF_P5</incoming>
    </endEvent>
    <exclusiveGateway id="GW_ProcesoVigente" name="¿Existe proceso universitario vigente?">
      <incoming>SF_P2</incoming>
      <outgoing>SF_GW_P_NO</outgoing>
      <outgoing>SF_GW_P_SI</outgoing>
    </exclusiveGateway>
    <task id="Task_P3_AprobarEmitir" name="Aprobar solicitud y emitir&#10;Certificado de No Proceso (Emisor)">
      <incoming>SF_GW_P_NO</incoming>
      <outgoing>SF_P3_SYS</outgoing>
    </task>
    <task id="Task_P2_RevisarAntecedentes" name="Revisar antecedentes del solicitante&#10;en registros universitarios">
      <incoming>SF_P1</incoming>
      <outgoing>SF_P2</outgoing>
    </task>
    <task id="Task_B1_RealizarPago" name="11. Realizar pago del CPT en entidad bancaria autorizada">
      <incoming>SF_11</incoming>
      <outgoing>SF_B1</outgoing>
    </task>
    <task id="Task_P1_RecibirSolicitud" name="Recibir solicitud del sistema&#10;(plazo de atención: 48 horas hábiles)">
      <incoming>Flow_0hh692g</incoming>
      <outgoing>SF_P1</outgoing>
    </task>
    <exclusiveGateway id="Gateway_1l4rubo" name="Confirmar transacción y acreditar pago al sistema">
      <incoming>SF_B1</incoming>
      <outgoing>Flow_0hh692g</outgoing>
      <outgoing>Flow_1m0r5qt</outgoing>
    </exclusiveGateway>
    <task id="Activity_0moowy2" name="Notificar al solicitante vía correo electrónico&#10;indicando el motivo del rechazo">
      <incoming>Flow_1m0r5qt</incoming>
      <outgoing>Flow_0pnvv6y</outgoing>
    </task>
    <endEvent id="Event_07m5kvt" name="Solicitud Cancelada &#10;por Falta de Confirmacion de pago">
      <incoming>Flow_0pnvv6y</incoming>
    </endEvent>
    <sequenceFlow id="SF_09" sourceRef="Task_C7_Finalizar" targetRef="Task_S1_RegistrarSolicitud" />
    <sequenceFlow id="SF_S1_CPT" sourceRef="Task_S1_RegistrarSolicitud" targetRef="Task_S2_GenerarCPT" />
