    <sequenceFlow id="SF_11" sourceRef="Task_C9_DescargarOrden" targetRef="Task_B1_RealizarPago" />
    <sequenceFlow id="SF_P3_END" sourceRef="Task_P3_AprobarEmitir" targetRef="End_Aprobado" />
    <sequenceFlow id="SF_P4" sourceRef="Task_P4_DenegarSolicitud" targetRef="Task_P5_NotificarRechazo" />
    <sequenceFlow id="SF_P5" sourceRef="Task_P5_NotificarRechazo" targetRef="End_Denegado" />
    <sequenceFlow id="SF_01" sourceRef="Start_Cert" targetRef="Task_C0_PrepararDocs" />
    <sequenceFlow id="SF_02" sourceRef="Task_C0_PrepararDocs" targetRef="Task_C1_AccesoWeb" />
